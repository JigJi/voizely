# Voizely Backend — copy this to .env and fill in the real values.
# .env is gitignored — NEVER commit it. Get the real secret values from the
# project owner via a password manager / encrypted channel, not from git/chat.

# --- Server ---
HOST=127.0.0.1
PORT=8800
UPLOAD_DIR=./uploads

# --- Whisper (local fallback) ---
WHISPER_MODEL_SIZE=Vinxscribe/biodatlab-whisper-th-large-v3-faster
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_MODEL_DIR=./models

# --- PostgreSQL ---
PG_DB=speech_text
PG_USER=postgres
PG_PASS=              # REQUIRED — Postgres password
PG_HOST=localhost
PG_PORT=5432

# --- Auth ---
# REQUIRED — JWT signing key. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Rotating this logs out all existing sessions.
SECRET_KEY=
FIXED_PASSWORD=       # dev login password (used only when AD_ENABLED=False)
AD_ENABLED=False

# Shared secret with frontend_auth (must match frontend_auth/.env INTERNAL_API_KEY)
INTERNAL_API_KEY=

# --- AI / ASR keys ---
# All Gemini calls go through OpenRouter (model google/gemini-2.5-flash) — this key is REQUIRED.
OPEN_ROUNTER=         # OpenRouter (starts sk-or-v1-...)
DEEPGRAM_API_KEY=     # Deepgram
HF_TOKEN=             # HuggingFace, for pyannote (starts hf_...)
ASSEMBLYAI_API_KEY=   # optional

# --- MS Teams Integration ---
MS_TEAMS_ENABLED=false
MS_TEAMS_TENANT_ID=
MS_TEAMS_CLIENT_ID=
MS_TEAMS_CLIENT_SECRET=
MS_TEAMS_POLL_USERS=  # comma-separated emails
